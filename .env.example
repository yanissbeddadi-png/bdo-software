# BDO Software — variables d'environnement (toutes optionnelles).
# Sans ces variables, l'application fonctionne en mode démonstration local.

# Supabase (projet cible). Clé « anon » uniquement : ne jamais exposer la clé service_role au navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tests Playwright : chemin d'un Chromium déjà installé (sinon Playwright utilise le sien).
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
