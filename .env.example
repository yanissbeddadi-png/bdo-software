# BDO Software CRM — variables d'environnement.
# Sans les variables Supabase, l'application fonctionne en mode démonstration (données dans le navigateur).

# Mode multi-utilisateur (comptes, mots de passe, données partagées) — voir README « Mode multi-utilisateur ».
# Valeurs publiques (Supabase › Project Settings › API) :
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Valeur SECRÈTE, côté serveur uniquement (jamais préfixée NEXT_PUBLIC_, jamais dans le dépôt) :
SUPABASE_SERVICE_ROLE_KEY=
# Code à saisir sur /installation pour créer le premier compte administrateur (choisissez-le) :
BDO_SETUP_CODE=

# Tests Playwright : chemin d'un Chromium déjà installé (sinon Playwright utilise le sien).
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
